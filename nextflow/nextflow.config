params {
    samplesheet = null
    resources = [:]
    modules = [:]
    project_path = "$baseDir/.."
    out_root = "$baseDir/../nextflow_results_dsl2"
    metahict_conda = "$baseDir/../installation/env.yaml"
    conda_envs_path = "$baseDir/../conda_envs"
    require_conda_bundle = false
    // All reference databases remain outside Conda environments. Users may
    // override each project-relative default with a normal
    // Nextflow parameter, for example --checkm2_db /data/CheckM2.dmnd.
    checkm_db = "$baseDir/../databases/checkm_db"
    checkm2_db = "$baseDir/../databases/checkm2_db/CheckM2_database/uniref100.KO.1.dmnd"
    gtdbtk_db = "$baseDir/../databases/gtdbtk_db/release220"
    genomad_db = "$baseDir/../databases/genomad_db/genomad_db"
    result_name = 'results'
    threads = null
    memory = null
    // Internal local-executor ceilings supplied by ./metahict. They reflect
    // host/cgroup capacity and are not scientific configuration parameters.
    local_resource_cpus = null
    local_resource_memory = null
    dry_run = false
    clean = false
    chain = true
    report_dir = "$baseDir/reports"
}

process {
    executor = 'local'
    shell = ['/bin/bash', '-euo', 'pipefail']
}

profiles {
    local {
        process.executor = 'local'
        process.resourceLimits = [
            cpus: params.local_resource_cpus,
            memory: params.local_resource_memory
        ]
        conda.enabled = true
        params.require_conda_bundle = true
        params.conda_envs_path = "${params.project_path}/conda_envs"
        params.metahict_conda = "${params.project_path}/conda_envs/metahict_env"
    }

    // Dependency-free profile used only with -stub-run in CI. It validates
    // the DSL2 graph and declared files, not scientific execution.
    stub {
        process.executor = 'local'
        conda.enabled = false
        params.require_conda_bundle = false
    }
}

timeline {
    enabled = true
    file = "${params.report_dir}/timeline.html"
    overwrite = true
}

report {
    enabled = true
    file = "${params.report_dir}/report.html"
    overwrite = true
}

trace {
    enabled = true
    file = "${params.report_dir}/trace.txt"
    overwrite = true
    fields = 'task_id,hash,native_id,process,tag,name,status,exit,cpus,memory,submit,start,complete,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar,workdir'
}

dag {
    enabled = true
    file = "${params.report_dir}/dag.html"
    overwrite = true
}
