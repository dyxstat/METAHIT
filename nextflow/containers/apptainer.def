Bootstrap: docker
From: condaforge/miniforge3:24.11.3-0

%environment
    export CONDA_BASE=/opt/conda
    export PATH=/opt/conda/envs/metahict_env/bin:/opt/conda/bin:/usr/local/bin:$PATH

%post
    lock_dir="{{ METAHICT_LOCK_DIR }}"
    pip_requirements="{{ METAHICT_PIP_REQUIREMENTS }}"
    conda config --set channel_priority flexible
    for env_name in {{ METAHICT_ENVS }}; do
        case "${env_name}" in
            metahict_env)
                conda create -y -n metahict_env --file "${lock_dir}/metahict_env.explicit.txt"
                ;;
            checkm2)
                conda create -y -n checkm2 --file "${lock_dir}/checkm2.explicit.txt"
                ;;
            gtdbtk-2.4.0)
                conda create -y -n gtdbtk-2.4.0 --file "${lock_dir}/gtdbtk-2.4.0.explicit.txt"
                ;;
            genomad)
                conda create -y -n genomad --file "${lock_dir}/genomad.explicit.txt"
                ;;
            ccfind_env)
                conda create -y -n ccfind_env --file "${lock_dir}/ccfind_env.explicit.txt"
                ;;
            *)
                echo "Unknown METAHICT env requested: ${env_name}" >&2
                exit 1
                ;;
        esac
    done
    conda clean -afy

    if [ -x /opt/conda/envs/metahict_env/bin/python ]; then
        /opt/conda/envs/metahict_env/bin/python -m pip install --no-deps --no-cache-dir -r "$pip_requirements"
        /opt/conda/envs/metahict_env/bin/python -c "import bin3c_python3"
    fi

    printf '#!/usr/bin/env bash\nexit 0\n' > /usr/local/bin/module
    chmod +x /usr/local/bin/module
    for spec in checkm2:checkm2 gtdbtk:gtdbtk-2.4.0 genomad:genomad; do
        tool="${spec%%:*}"
        env_name="${spec##*:}"
        printf '#!/usr/bin/env bash\nexec conda run -n %s %s "$@"\n' "${env_name}" "${tool}" > "/usr/local/bin/${tool}"
        chmod +x "/usr/local/bin/${tool}"
    done

%runscript
    exec "$@"
